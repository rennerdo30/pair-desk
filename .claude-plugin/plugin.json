  "keywords": [
    "playtest",
    "game-dev",
    "qa",
    "issues",
    "backlog",
    "handoff",
    "mcp",
    "channels",
    "local",
    "codex",
    "opencode"
  ],
  "mcpServers": {
    "pair-desk": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/pair-desk",
      "args": [
        "mcp"
      ]
    }
